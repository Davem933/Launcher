<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark build only: lets macrobenchmark / Perfetto read the app's trace sections
     (frame timing, startup) without making the build debuggable, which would skew results. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
